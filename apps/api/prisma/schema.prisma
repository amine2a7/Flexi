// FlexiPay data model. Money: BIGINT millimes only. Rates: integer basis points.
// The ledger tables (ledger_*) are written only through LedgerService with raw SQL; triggers forbid
// UPDATE and DELETE on them (migration 0001). Row-Level Security policies are in the migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ enums

enum Role {
  ADMIN
  COMPANY
  MERCHANT
  EMPLOYEE
  FAMILY_MEMBER
}

enum SubRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
  COMPLIANCE
  OWNER
  MANAGER
  ACCOUNTANT
  READ_ONLY
  CASHIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SessionStep {
  NONE
  PASSWORD_CHANGE
  MFA_ENROLL
}

enum CreditType {
  RESTAURATION
  HABILLEMENT
  CARBURANT
  CADEAUX
}

enum AccountStatus {
  PENDING_KYC
  APPROVED
  REJECTED
  SUSPENDED
}

enum MerchantCategory {
  RESTAURANT
  CAFE
  GROCERY
  BAKERY
  FAST_FOOD
  CLOTHING
  FUEL_STATION
  GIFT_SHOP
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  AWAITING_PAYMENT
  AWAITING_VALIDATION
  VALIDATED
  REFUSED
  CANCELLED
}

enum OrderEventAction {
  CREATED
  CONFIRMED
  REFUSED
  CANCELLED
  TRANSFER_DECLARED
  PROOF_REJECTED
  FIRST_VALIDATION
  VALIDATED
}

enum InvoiceStatus {
  PAID
  UNPAID
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  CONFIRMED
  SETTLED
  REFUSED
  DISPUTED
  REFUNDED
}

enum PaymentChannel {
  CUSTOMER_CODE
  MERCHANT_CODE
}

/// Legal form of a client (processus v2): drives the withholding tax rate.
enum LegalForm {
  PP_CIN
  PP_MF
  PM_MF
}

enum PayoutStatus {
  REQUESTED
  CHECKED
  SENT
  EXECUTED
  REJECTED
  ON_HOLD
}

enum SettlementStatus {
  SCHEDULED
  RELEASED
  SENT
  PAID
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycAccountType {
  MERCHANT
  COMPANY
}

enum KycDocumentType {
  REGISTRY_EXTRACT
  TAX_CERTIFICATE
  MANAGER_ID
  MANAGER_ID_FRONT
  MANAGER_ID_BACK
  BANK_DETAILS
  COMPANY_STATUTES
  PROOF_OF_ADDRESS
}

enum KycAction {
  SUBMITTED
  APPROVED
  REJECTED
  DOCUMENT_UPLOADED
  CORRECTION_REQUESTED
}

/// Status of a KYC document (processus v2); a type with no document is « à déposer ».
enum KycDocumentStatus {
  SUBMITTED
  VALIDATED
  TO_CORRECT
}

enum ApprovalType {
  COMMISSION_RATE_CHANGE
  SETTINGS_CHANGE
  COMMISSION_GRID_CHANGE
  DISPUTE_REFUND
  IBAN_CHANGE
  BATCH_RELEASE
  LEGAL_FORM_CHANGE
}

enum FraudAlertKind {
  REPEATED_REFUSALS
  MERCHANT_BURST
  NEAR_DAILY_LIMIT
  RIB_CHANGE_PAYOUT
  NEW_DEVICE_PAYMENT
  COMMISSION_GRID_MISSING
  LEDGER_MISMATCH
}

enum FraudAlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum FraudAlertStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum DisputeStatus {
  OPEN
  ACCEPTANCE_PENDING
  ACCEPTED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MerchantDocumentType {
  COMMISSION_INVOICE
  STATEMENT
  CERTIFICATE
}

enum ContactRequesterType {
  COMPANY
  MERCHANT
  OTHER
}

enum ContactMessageStatus {
  NEW
  HANDLED
}

enum IdempotencyState {
  IN_PROGRESS
  DONE
}

// ------------------------------------------------------------------ tenants and users

model Company {
  id                    String        @id @default(uuid(7)) @db.Uuid
  name                  String        @db.VarChar(200)
  city                  String        @db.VarChar(80)
  phone                 String // encrypted (AES-256-GCM)
  email                 String        @db.VarChar(254)
  status                AccountStatus @default(PENDING_KYC)
  legalForm             LegalForm     @default(PM_MF) @map("legal_form")
  /// Family accounts allowed for its employees (processus v2, on by default).
  familyAccountsEnabled Boolean       @default(true) @map("family_accounts_enabled")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  users               User[]
  employees           Employee[]
  orders              CreditOrder[]
  invoices            Invoice[]
  kycFiles            KycFile[]
  commissionGrids     CommissionGrid[]
  departments         Department[]
  orderQuotes         OrderQuote[]
  allocationTemplates AllocationTemplate[]

  @@map("companies")
}

/// Department of a company (cahier ENT-04): groups its employees.
model Department {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String    @db.VarChar(80)
  /// Archived: hidden from the choices, kept for the history (never with employees).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company             Company              @relation(fields: [companyId], references: [id])
  employees           Employee[]
  allocationTemplates AllocationTemplate[]

  @@map("departments")
}

/// Commission grid of a company or a merchant (decision of 2026-11-03). Versions are immutable:
/// the current grid is the latest one; a change inserts a new version after the second validation.
model CommissionGrid {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  merchantId    String?  @map("merchant_id") @db.Uuid
  approvalId    String?  @map("approval_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)

  company  Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  merchant Merchant?        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  approval Approval?        @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  tiers    CommissionTier[]

  @@index([companyId, effectiveFrom], map: "commission_grids_company_idx")
  @@index([merchantId, effectiveFrom], map: "commission_grids_merchant_idx")
  @@map("commission_grids")
}

/// Change of a company or merchant record (decision of 2026-11-03): field names only, no values.
model AccountChange {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  merchantId String?  @map("merchant_id") @db.Uuid
  fields     String[] @db.VarChar(40)
  reason     String?  @db.VarChar(500)
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(120)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([companyId, occurredAt], map: "account_changes_company_idx")
  @@index([merchantId, occurredAt], map: "account_changes_merchant_idx")
  @@map("account_changes")
}

/// Line of a grid: tranche [min, max) in millimes, or the default line (no bounds).
model CommissionTier {
  gridId      String  @map("grid_id") @db.Uuid
  position    Int
  rateBps     Int     @map("rate_bps")
  minMillimes BigInt? @map("min_millimes")
  maxMillimes BigInt? @map("max_millimes")

  grid CommissionGrid @relation(fields: [gridId], references: [id], onDelete: Restrict)

  @@id([gridId, position])
  @@map("commission_tiers")
}

model Merchant {
  id                  String           @id @default(uuid(7)) @db.Uuid
  name                String           @db.VarChar(200)
  category            MerchantCategory
  city                String           @db.VarChar(80)
  address             String           @default("") @db.VarChar(200)
  phone               String // encrypted (AES-256-GCM)
  email               String           @db.VarChar(254)
  status              AccountStatus    @default(PENDING_KYC)
  acceptedCreditTypes CreditType[]     @map("accepted_credit_types")
  legalForm           LegalForm        @default(PM_MF) @map("legal_form")
  /// 6-digit code shown at the till and in the merchant QR (flexipay:merchant:<code>).
  paymentCode         String           @unique @map("payment_code") @db.Char(6)
  /// Bank account for payouts (TN + 22 digits). Masked everywhere except the admin payout control.
  iban                String? // encrypted (AES-256-GCM)
  /// Administrator who created the merchant: never the approver of its payouts (QY-03 b).
  createdBy           String?          @map("created_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  commissionGrids CommissionGrid[]
  users           User[]
  pointsOfSale    PointOfSale[]
  payments        Payment[]
  payouts         PayoutRequest[]
  payoutQuotes    PayoutQuote[]
  documents       MerchantDocument[]
  kycFiles        KycFile[]
  disputes        Dispute[]

  @@map("merchants")
}

model PointOfSale {
  id         String @id @default(uuid(7)) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  name       String @db.VarChar(120)
  city       String @db.VarChar(80)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("points_of_sale")
}

model Employee {
  id                String         @id @default(uuid(7)) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  employeeNumber    String         @map("employee_number") @db.VarChar(20)
  firstName         String         @map("first_name") @db.VarChar(60)
  lastName          String         @map("last_name") @db.VarChar(60)
  email             String         @db.VarChar(254)
  phone             String // encrypted (AES-256-GCM)
  status            EmployeeStatus @default(INVITED)
  /// Argon2id hash of the 4-digit payment PIN.
  pinHash           String?        @map("pin_hash")
  pinFailures       Int            @default(0) @map("pin_failures")
  pinLockedUntil    DateTime?      @map("pin_locked_until") @db.Timestamptz(3)
  /// Number of PIN locks in a row (15, 30, 60 min, then a full sign-in is required).
  pinLockLevel      Int            @default(0) @map("pin_lock_level")
  pinRequiresReauth Boolean        @default(false) @map("pin_requires_reauth")
  /// End of the grace period of a deactivated employee (only spending its balance until then).
  graceUntil        DateTime?      @map("grace_until") @db.Timestamptz(3)
  /// Free text (processus v2), e.g. « Ouvrier »; the positions in use are suggested.
  position          String?        @db.VarChar(80)
  departmentId      String?        @map("department_id") @db.Uuid
  /// Family member (processus v2): the beneficiary who holds this account, and the link.
  holderEmployeeId  String?        @map("holder_employee_id") @db.Uuid
  relationship      String?        @db.VarChar(20)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  holder       Employee?     @relation("FamilyMembers", fields: [holderEmployeeId], references: [id])
  members      Employee[]    @relation("FamilyMembers")
  memberGrants FamilyGrant[] @relation("GrantMember")
  holderGrants FamilyGrant[] @relation("GrantHolder")
  user         User?
  payments     Payment[]
  paymentCodes PaymentCode[]
  allocations  Allocation[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@map("employees")
}

/// Daily cap and end date set by the holder on the credit of a family member, per type.
model FamilyGrant {
  memberEmployeeId   String     @map("member_employee_id") @db.Uuid
  holderEmployeeId   String     @map("holder_employee_id") @db.Uuid
  creditType         CreditType @map("credit_type")
  dailyLimitMillimes BigInt?    @map("daily_limit_millimes")
  endsOn             DateTime?  @map("ends_on") @db.Date
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  member Employee @relation("GrantMember", fields: [memberEmployeeId], references: [id])
  holder Employee @relation("GrantHolder", fields: [holderEmployeeId], references: [id])

  @@id([memberEmployeeId, creditType])
  @@map("family_grants")
}

/// One account = one tenant (RG-2.5): companyId, merchantId or employeeId, never two of them.
model User {
  id                    String     @id @default(uuid(7)) @db.Uuid
  role                  Role
  subRole               SubRole?   @map("sub_role")
  displayName           String     @map("display_name") @db.VarChar(120)
  /// Normalized sign-in identifier (lower-case e-mail).
  email                 String     @unique @db.VarChar(254)
  /// Encrypted (AES-256-GCM); found and kept unique by phoneHash.
  phone                 String?
  phoneHash             String?    @unique @map("phone_hash") @db.Char(64)
  passwordHash          String     @map("password_hash")
  mustChangePassword    Boolean    @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime?  @map("temp_password_expires_at") @db.Timestamptz(3)
  /// TOTP secret, AES-256-GCM encrypted (never stored in clear).
  mfaSecretEnc          String?    @map("mfa_secret_enc")
  mfaPendingSecretEnc   String?    @map("mfa_pending_secret_enc")
  mfaPendingExpiresAt   DateTime?  @map("mfa_pending_expires_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step (a code is never accepted twice).
  mfaLastStep           BigInt?    @map("mfa_last_step")
  status                UserStatus @default(ACTIVE)
  failedLogins          Int        @default(0) @map("failed_logins")
  lockedUntil           DateTime?  @map("locked_until") @db.Timestamptz(3)
  onboardingTourDone    Boolean    @default(false) @map("onboarding_tour_done")
  /// Moment of the deactivation (irreversible).
  deactivatedAt         DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  companyId             String?    @map("company_id") @db.Uuid
  merchantId            String?    @map("merchant_id") @db.Uuid
  employeeId            String?    @unique @map("employee_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  company       Company?             @relation(fields: [companyId], references: [id])
  merchant      Merchant?            @relation(fields: [merchantId], references: [id])
  employee      Employee?            @relation(fields: [employeeId], references: [id])
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  challenges    MfaChallenge[]
  resetTokens   PasswordResetToken[]
  loginFailures LoginFailure[]

  @@index([companyId])
  @@index([merchantId])
  @@map("users")
}

model RecoveryCode {
  id       String    @id @default(uuid(7)) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Web session. Tokens are random and stored as SHA-256 hashes; a refresh rotates the row inside
/// its family, and the reuse of a rotated refresh token revokes the whole family.
model Session {
  id                String      @id @default(uuid(7)) @db.Uuid
  familyId          String      @map("family_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  step              SessionStep
  accessTokenHash   String      @unique @map("access_token_hash")
  refreshTokenHash  String      @unique @map("refresh_token_hash")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime    @map("absolute_expires_at") @db.Timestamptz(3)
  restrictedUntil   DateTime?   @map("restricted_until") @db.Timestamptz(3)
  rotatedAt         DateTime?   @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model MfaChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  /// LINK (e-mail) or OTP (6-digit SMS code, at most 5 attempts).
  kind      String    @default("LINK") @db.VarChar(4)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// Failed sign-ins per (account, IP) couple (spec 01 §3: 5 failures -> 15 min for this couple).
model LoginFailure {
  userId       String    @map("user_id") @db.Uuid
  ip           String    @db.VarChar(64)
  count        Int       @default(0)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ip])
  @@map("login_failures")
}

// ------------------------------------------------------------------ settings

enum ExpiredCreditsDestination {
  PLATFORM_REVENUE
  COMPANY_RETURN
}

model PlatformSettings {
  id                                Int                       @id @default(1)
  payoutMinimumMillimes             BigInt                    @map("payout_minimum_millimes")
  creditValidityMonths              Int                       @map("credit_validity_months")
  maxFamilyMembers                  Int                       @map("max_family_members")
  /// Documents a client files for its KYC (processus v2), chosen by the super-admin.
  kycRequiredDocuments              KycDocumentType[]         @default([REGISTRY_EXTRACT, TAX_CERTIFICATE, MANAGER_ID_FRONT, MANAGER_ID_BACK, BANK_DETAILS]) @map("kyc_required_documents")
  orderFeeRateBps                   Int                       @map("order_fee_rate_bps")
  /// VAT on the commission and stamp duty (decision of 2026-11-03), set by the super-admin.
  vatRateBps                        Int                       @default(1900) @map("vat_rate_bps")
  stampDutyMillimes                 BigInt                    @default(1000) @map("stamp_duty_millimes")
  /// Withholding tax (processus v2): above the threshold, rate of the legal form on the commission.
  withholdingThresholdMillimes      BigInt                    @default(1000000) @map("withholding_threshold_millimes")
  withholdingPpCinBps               Int                       @default(300) @map("withholding_pp_cin_bps")
  withholdingPpMfBps                Int                       @default(150) @map("withholding_pp_mf_bps")
  withholdingPmMfBps                Int                       @default(100) @map("withholding_pm_mf_bps")
  /// Transfer fee on every order and every merchant payout.
  transferFeeMillimes               BigInt                    @default(4000) @map("transfer_fee_millimes")
  /// Where the remainder of expired lots goes (provisional, decision of 2026-10-14).
  expiredCreditsDestination         ExpiredCreditsDestination @default(PLATFORM_REVENUE) @map("expired_credits_destination")
  /// Grace period of a deactivated employee, in days (decision e3 of 2026-10-22).
  accountGraceDays                  Int                       @default(30) @map("account_grace_days")
  /// Thresholds of the fraud rules (decision of 2026-10-31), set by the super-admin.
  fraudRules                        Json                      @default("{\"refusedCount\":5,\"refusedMinutes\":10,\"merchantCount\":3,\"merchantMinutes\":5,\"limitPercent\":80,\"ribPayoutHours\":24}") @map("fraud_rules")
  /// FlexiPay bank account where companies transfer their orders (request of 2026-11-05).
  fundingBankName                   String                    @default("Banque Internationale Arabe de Tunisie (BIAT)") @map("funding_bank_name") @db.VarChar(120)
  fundingHolder                     String                    @default("FlexiPay SA") @map("funding_holder") @db.VarChar(120)
  fundingRib                        String                    @default("08006000671234567891") @map("funding_rib") @db.VarChar(20)
  fundingIban                       String                    @default("TN5908006000671234567891") @map("funding_iban") @db.VarChar(24)
  /// Above this amount, a credit order needs two administrators (frozen in each order).
  secondValidationThresholdMillimes BigInt                    @default(10000000) @map("second_validation_threshold_millimes")
  quoteValidityDays                 Int                       @default(7) @map("quote_validity_days")
  invitationValidityDays            Int                       @default(7) @map("invitation_validity_days")
  /// Validity of the sign-in code (MFA challenge).
  otpValidityMinutes                Int                       @default(5) @map("otp_validity_minutes")
  /// Successive PIN locks, in minutes; past the last one, only a full sign-in lifts the lock.
  pinLockMinutes                    Int[]                     @default([15, 30, 60]) @map("pin_lock_minutes")
  /// A shop may cancel a confirmed payment within this window (hours).
  paymentCancelHours                Int                       @default(24) @map("payment_cancel_hours")
  /// Settlement cycle: a payment is settled D + this number of business days.
  settlementDelayDays               Int                       @default(2) @map("settlement_delay_days")
  updatedAt                         DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model CreditTypeSetting {
  creditType         CreditType @id @map("credit_type")
  enabled            Boolean
  commissionRateBps  Int        @map("commission_rate_bps")
  validityMonths     Int        @map("validity_months")
  dailyLimitMillimes BigInt     @map("daily_limit_millimes")

  @@map("credit_type_settings")
}

model Approval {
  id              String           @id @default(uuid(7)) @db.Uuid
  type            ApprovalType
  status          ApprovalStatus   @default(PENDING)
  subject         String           @db.VarChar(200)
  /// Change to apply once approved (profile id + new rate, or the full settings).
  payload         Json
  oldRateBps      Int?             @map("old_rate_bps")
  newRateBps      Int?             @map("new_rate_bps")
  reason          String           @db.VarChar(500)
  initiatorId     String           @map("initiator_id") @db.Uuid
  initiatorName   String           @map("initiator_name") @db.VarChar(120)
  deciderId       String?          @map("decider_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at") @db.Timestamptz(3)
  rejectReason    String?          @map("reject_reason") @db.VarChar(500)
  commissionGrids CommissionGrid[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("approvals")
}

/// Append-only (trigger): sensitive actions, never any secret, PIN, token or full balance.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String   @map("actor_name") @db.VarChar(120)
  action      String   @db.VarChar(64)
  target      String   @db.VarChar(200)
  /// User the entry is about (history of an account).
  subjectId   String?  @map("subject_id") @db.Uuid
  /// Reason typed by the actor (status and role changes).
  reason      String?  @db.VarChar(500)

  @@index([occurredAt])
  @@index([subjectId, occurredAt], map: "audit_log_subject_id_idx")
  @@map("audit_log")
}

// ------------------------------------------------------------------ credit orders

model CreditOrder {
  id                       String      @id @default(uuid(7)) @db.Uuid
  reference                String      @unique @db.VarChar(32)
  companyId                String      @map("company_id") @db.Uuid
  status                   OrderStatus @default(AWAITING_CONFIRMATION)
  amountMillimes           BigInt      @map("amount_millimes")
  feeRateBps               Int         @map("fee_rate_bps")
  feesMillimes             BigInt      @map("fees_millimes")
  /// VAT on the commission and stamp duty, frozen in the order (decision of 2026-11-03).
  vatRateBps               Int         @default(0) @map("vat_rate_bps")
  vatMillimes              BigInt      @default(0) @map("vat_millimes")
  stampDutyMillimes        BigInt      @default(0) @map("stamp_duty_millimes")
  withholdingRateBps       Int         @default(0) @map("withholding_rate_bps")
  withholdingMillimes      BigInt      @default(0) @map("withholding_millimes")
  transferFeeMillimes      BigInt      @default(0) @map("transfer_fee_millimes")
  totalMillimes            BigInt      @map("total_millimes")
  /// Reference to write on the bank transfer.
  paymentReference         String      @map("payment_reference") @db.VarChar(32)
  declaredAmountMillimes   BigInt?     @map("declared_amount_millimes")
  transferReference        String?     @map("transfer_reference") @db.VarChar(64)
  transferDate             DateTime?   @map("transfer_date") @db.Date
  declaredAt               DateTime?   @map("declared_at") @db.Timestamptz(3)
  proofStorageKey          String?     @map("proof_storage_key")
  proofFileName            String?     @map("proof_file_name") @db.VarChar(255)
  proofContentType         String?     @map("proof_content_type") @db.VarChar(40)
  proofSizeBytes           Int?        @map("proof_size_bytes")
  refusalReason            String?     @map("refusal_reason") @db.VarChar(500)
  proofRejectionReason     String?     @map("proof_rejection_reason") @db.VarChar(500)
  firstValidatorId         String?     @map("first_validator_id") @db.Uuid
  firstValidatorName       String?     @map("first_validator_name") @db.VarChar(120)
  firstValidatedAt         DateTime?   @map("first_validated_at") @db.Timestamptz(3)
  /// End of the quote and four-eyes rule, frozen at creation (settings of 2026-11-05).
  quoteExpiresAt           DateTime    @default(dbgenerated("(now() + '7 days'::interval)")) @map("quote_expires_at") @db.Timestamptz(3)
  secondValidationRequired Boolean     @default(false) @map("second_validation_required")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company            @relation(fields: [companyId], references: [id])
  lines   CreditOrderLine[]
  events  CreditOrderEvent[]
  invoice Invoice?

  @@index([companyId, createdAt])
  @@index([status])
  @@map("credit_orders")
}

/// Quote of a credit order, frozen for the validity of the settings; an order takes its amounts.
model OrderQuote {
  id                  String    @id @default(uuid(7)) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  /// [{ creditType, amountMillimes }] as quoted.
  lines               Json
  amountMillimes      BigInt    @map("amount_millimes")
  feeRateBps          Int       @map("fee_rate_bps")
  feesMillimes        BigInt    @map("fees_millimes")
  vatRateBps          Int       @map("vat_rate_bps")
  vatMillimes         BigInt    @map("vat_millimes")
  stampDutyMillimes   BigInt    @map("stamp_duty_millimes")
  withholdingRateBps  Int       @default(0) @map("withholding_rate_bps")
  withholdingMillimes BigInt    @default(0) @map("withholding_millimes")
  transferFeeMillimes BigInt    @default(0) @map("transfer_fee_millimes")
  totalMillimes       BigInt    @map("total_millimes")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt              DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("order_quotes")
}

model CreditOrderLine {
  orderId        String     @map("order_id") @db.Uuid
  creditType     CreditType @map("credit_type")
  amountMillimes BigInt     @map("amount_millimes")

  order CreditOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, creditType])
  @@map("credit_order_lines")
}

model CreditOrderEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  action     OrderEventAction
  actorId    String?          @map("actor_id") @db.Uuid
  actorName  String           @map("actor_name") @db.VarChar(120)
  actorRole  Role             @map("actor_role")
  reason     String?          @db.VarChar(500)
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  order CreditOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("credit_order_events")
}

model Invoice {
  id               String        @id @default(uuid(7)) @db.Uuid
  number           String        @unique @db.VarChar(32)
  companyId        String        @map("company_id") @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  totalMillimes    BigInt        @map("total_millimes")
  status           InvoiceStatus
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Credit note of an invoice cancelled with its order (request of 2026-11-05).
  creditNoteNumber String?       @unique @map("credit_note_number") @db.VarChar(32)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)

  company Company     @relation(fields: [companyId], references: [id])
  order   CreditOrder @relation(fields: [orderId], references: [id])

  @@index([companyId])
  @@map("invoices")
}

model Allocation {
  id             String     @id @default(uuid(7)) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  creditType     CreditType @map("credit_type")
  amountMillimes BigInt     @map("amount_millimes")
  transactionId  String     @map("transaction_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The template it was relaunched from (processus v2), null for a free allocation.
  templateId     String?    @map("template_id") @db.Uuid

  employee Employee            @relation(fields: [employeeId], references: [id])
  template AllocationTemplate? @relation(fields: [templateId], references: [id])

  @@index([companyId, createdAt])
  @@index([employeeId])
  @@map("allocations")
}

/// Allocation template (processus v2, processus 4): filters and amount per type, relaunched with
/// the current employees of the filters (never a frozen list of people). Archived, never deleted.
model AllocationTemplate {
  id                String    @id @default(uuid(7)) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  name              String    @db.VarChar(80)
  departmentId      String?   @map("department_id") @db.Uuid
  position          String?   @db.VarChar(80)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  lastRunAt         DateTime? @map("last_run_at") @db.Timestamptz(3)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Day of the month (1 to 28) of the automatic relaunch; null = by hand only.
  autoMonthlyDay    Int?      @map("auto_monthly_day") @db.SmallInt
  /// Month (YYYY-MM) of the last automatic relaunch, and its outcome (DONE or the refusal).
  lastAutoRunMonth  String?   @map("last_auto_run_month") @db.Char(7)
  lastAutoRunStatus String?   @map("last_auto_run_status") @db.VarChar(30)

  company     Company                    @relation(fields: [companyId], references: [id])
  department  Department?                @relation(fields: [departmentId], references: [id])
  amounts     AllocationTemplateAmount[]
  allocations Allocation[]

  @@map("allocation_templates")
}

model AllocationTemplateAmount {
  templateId     String     @map("template_id") @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  creditType     CreditType @map("credit_type")
  amountMillimes BigInt     @map("amount_millimes")

  template AllocationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, creditType])
  @@map("allocation_template_amounts")
}

// ------------------------------------------------------------------ payments

model PaymentCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  code       String    @db.Char(8)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([code])
  @@map("payment_codes")
}

model Payment {
  id                   String         @id @default(uuid(7)) @db.Uuid
  reference            String         @unique @db.VarChar(32)
  merchantId           String         @map("merchant_id") @db.Uuid
  employeeId           String         @map("employee_id") @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  creditType           CreditType     @map("credit_type")
  amountMillimes       BigInt         @map("amount_millimes")
  status               PaymentStatus
  channel              PaymentChannel
  /// Deadline of an INITIATED request (the beneficiary confirms with the PIN before it).
  expiresAt            DateTime?      @map("expires_at") @db.Timestamptz(3)
  /// Commission rate of the credit type when the payment was confirmed (display only; the payout
  /// request freezes its own rate, rule 5).
  commissionRateBps    Int?           @map("commission_rate_bps")
  confirmedAt          DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  settlementDate       DateTime?      @map("settlement_date") @db.Date
  transactionId        String?        @map("transaction_id") @db.Uuid
  payoutId             String?        @map("payout_id") @db.Uuid
  /// Snapshot shown to the merchant (never the employees table).
  customerFirstName    String         @default("") @map("customer_first_name") @db.VarChar(60)
  customerLastInitial  String         @default("") @map("customer_last_initial") @db.VarChar(1)
  customerMaskedNumber String         @default("") @map("customer_masked_number") @db.VarChar(20)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  employee Employee       @relation(fields: [employeeId], references: [id])
  events   PaymentEvent[]

  dispute Dispute?

  @@index([merchantId, createdAt])
  @@index([employeeId, createdAt])
  @@index([status])
  @@index([employeeId, status, expiresAt], map: "payments_employee_status_idx")
  @@index([status, createdAt], map: "payments_status_created_idx")
  @@map("payments")
}

model PaymentEvent {
  id         String        @id @default(uuid(7)) @db.Uuid
  paymentId  String        @map("payment_id") @db.Uuid
  status     PaymentStatus
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

/// Expiry of credit lots (constat): one row per expired remainder, linked to its ledger entry.
model CreditExpiry {
  id             String     @id @default(uuid(7)) @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  creditType     CreditType @map("credit_type")
  amountMillimes BigInt     @map("amount_millimes")
  transactionId  String     @map("transaction_id") @db.Uuid
  occurredAt     DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([employeeId])
  @@map("credit_expiries")
}

// ------------------------------------------------------------------ payouts and settlements

model PayoutQuote {
  id                  String     @id @default(uuid(7)) @db.Uuid
  merchantId          String     @map("merchant_id") @db.Uuid
  creditType          CreditType @map("credit_type")
  grossMillimes       BigInt     @map("gross_millimes")
  commissionRateBps   Int        @map("commission_rate_bps")
  commissionMillimes  BigInt     @map("commission_millimes")
  /// VAT and stamp duty of the simulation (decision of 2026-11-03).
  vatRateBps          Int        @default(0) @map("vat_rate_bps")
  vatMillimes         BigInt     @default(0) @map("vat_millimes")
  stampDutyMillimes   BigInt     @default(0) @map("stamp_duty_millimes")
  withholdingRateBps  Int        @default(0) @map("withholding_rate_bps")
  withholdingMillimes BigInt     @default(0) @map("withholding_millimes")
  transferFeeMillimes BigInt     @default(0) @map("transfer_fee_millimes")
  netMillimes         BigInt     @map("net_millimes")
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt              DateTime?  @map("used_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("payout_quotes")
}

model PayoutRequest {
  id                  String       @id @default(uuid(7)) @db.Uuid
  reference           String       @unique @db.VarChar(32)
  merchantId          String       @map("merchant_id") @db.Uuid
  creditType          CreditType   @map("credit_type")
  status              PayoutStatus @default(REQUESTED)
  grossMillimes       BigInt       @map("gross_millimes")
  /// Rate frozen when the request is made (rule 5).
  commissionRateBps   Int          @map("commission_rate_bps")
  commissionMillimes  BigInt       @map("commission_millimes")
  /// VAT and stamp duty frozen in the request (decision of 2026-11-03).
  vatRateBps          Int          @default(0) @map("vat_rate_bps")
  vatMillimes         BigInt       @default(0) @map("vat_millimes")
  stampDutyMillimes   BigInt       @default(0) @map("stamp_duty_millimes")
  withholdingRateBps  Int          @default(0) @map("withholding_rate_bps")
  withholdingMillimes BigInt       @default(0) @map("withholding_millimes")
  transferFeeMillimes BigInt       @default(0) @map("transfer_fee_millimes")
  netMillimes         BigInt       @map("net_millimes")
  /// IBAN at the time of the request (the transfer goes there even if the shop changes it).
  iban                String // encrypted (AES-256-GCM)
  batchId             String?      @map("batch_id") @db.Uuid
  transactionId       String?      @map("transaction_id") @db.Uuid
  /// Merchant debt (accepted dispute on a paid payment) deducted from this payout when executed.
  deductedMillimes    BigInt       @default(0) @map("deducted_millimes")
  /// Payment recorded by Finance (bank transfer made outside the platform).
  bankReference       String?      @map("bank_reference") @db.VarChar(40)
  paidOn              DateTime?    @map("paid_on") @db.Date
  paidAmountMillimes  BigInt?      @map("paid_amount_millimes")
  paymentNote         String?      @map("payment_note") @db.VarChar(500)
  requestedAt         DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)

  merchant Merchant         @relation(fields: [merchantId], references: [id])
  batch    SettlementBatch? @relation(fields: [batchId], references: [id])
  events   PayoutEvent[]
  disputes Dispute[]

  @@index([merchantId, requestedAt])
  @@index([status])
  @@map("payout_requests")
}

model PayoutEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  payoutId   String       @map("payout_id") @db.Uuid
  status     PayoutStatus
  reason     String?      @db.VarChar(500)
  actorId    String?      @map("actor_id") @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  payout PayoutRequest @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@map("payout_events")
}

model SettlementBatch {
  id             String           @id @default(uuid(7)) @db.Uuid
  reference      String           @unique @db.VarChar(32)
  settlementDate DateTime         @map("settlement_date") @db.Date
  status         SettlementStatus @default(SCHEDULED)
  /// Finance released it (four eyes), the bank received its order, the reference of that order.
  releasedAt     DateTime?        @map("released_at") @db.Timestamptz(3)
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(3)
  bankReference  String?          @map("bank_reference") @db.VarChar(40)
  paidOn         DateTime?        @map("paid_on") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payouts PayoutRequest[]

  @@map("settlement_batches")
}

model MerchantDocument {
  id         String               @id @default(uuid(7)) @db.Uuid
  merchantId String               @map("merchant_id") @db.Uuid
  type       MerchantDocumentType
  period     String               @db.Char(7)
  issuedAt   DateTime             @default(now()) @map("issued_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_documents")
}

// ------------------------------------------------------------------ KYC

model KycFile {
  id              String         @id @default(uuid(7)) @db.Uuid
  accountType     KycAccountType @map("account_type")
  companyId       String?        @map("company_id") @db.Uuid
  merchantId      String?        @map("merchant_id") @db.Uuid
  status          KycStatus      @default(PENDING)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(500)
  /// Administrator who opened the file: never its decider (four eyes).
  createdBy       String?        @map("created_by") @db.Uuid
  submittedAt     DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)

  company   Company?      @relation(fields: [companyId], references: [id])
  merchant  Merchant?     @relation(fields: [merchantId], references: [id])
  documents KycDocument[]
  events    KycEvent[]

  @@index([status])
  @@map("kyc_files")
}

model KycDocument {
  id               String            @id @default(uuid(7)) @db.Uuid
  fileId           String            @map("file_id") @db.Uuid
  type             KycDocumentType
  fileName         String            @map("file_name") @db.VarChar(255)
  contentType      String            @map("content_type") @db.VarChar(40)
  sizeBytes        Int               @map("size_bytes")
  storageKey       String            @map("storage_key")
  uploadedAt       DateTime          @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  status           KycDocumentStatus @default(SUBMITTED)
  correctionReason String?           @map("correction_reason") @db.VarChar(500)
  /// A newer upload of the same type replaced it (kept for the history).
  replacedAt       DateTime?         @map("replaced_at") @db.Timestamptz(3)

  file KycFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("kyc_documents")
}

model KycEvent {
  id         String    @id @default(uuid(7)) @db.Uuid
  fileId     String    @map("file_id") @db.Uuid
  action     KycAction
  actorName  String    @map("actor_name") @db.VarChar(120)
  reason     String?   @db.VarChar(500)
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  file KycFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("kyc_events")
}

// ------------------------------------------------------------------ contact

model ContactMessage {
  id            String               @id @default(uuid(7)) @db.Uuid
  reference     String               @unique @db.VarChar(32)
  name          String               @db.VarChar(120)
  email         String               @db.VarChar(254)
  phone         String? // encrypted (AES-256-GCM)
  companyName   String?              @map("company_name") @db.VarChar(200)
  requesterType ContactRequesterType @map("requester_type")
  message       String               @db.VarChar(2000)
  status        ContactMessageStatus @default(NEW)
  receivedAt    DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  handledAt     DateTime?            @map("handled_at") @db.Timestamptz(3)
  handledBy     String?              @map("handled_by") @db.VarChar(120)
  note          String?              @db.VarChar(500)

  @@index([receivedAt])
  @@map("contact_messages")
}

// ------------------------------------------------------------------ idempotency registry

/// Registry of Idempotency-Key (contract §5), distinct from the ledger. Scope = (tenant, user, key).
model IdempotencyKey {
  scope          String           @db.VarChar(80)
  userId         String           @map("user_id") @db.Uuid
  key            String           @db.Uuid
  fingerprint    String           @db.Char(64)
  state          IdempotencyState
  fenceToken     String           @map("fence_token") @db.Uuid
  leaseUntil     DateTime         @map("lease_until") @db.Timestamptz(3)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, userId, key])
  @@map("idempotency_keys")
}

// ------------------------------------------------------------------ ledger (raw SQL only)

enum LedgerAccountKind {
  ASSET
  LIABILITY
  REVENUE
}

enum LedgerOwnerType {
  PLATFORM
  COMPANY
  EMPLOYEE
  MERCHANT
}

enum EntryDirection {
  D
  C
}

/// Ledger account. Wallets exist per owner AND per credit type (no transfer between types).
model LedgerAccount {
  id          String            @id @default(uuid(7)) @db.Uuid
  /// e.g. EMPLOYEE_WALLET:<employeeId>:RESTAURATION, BANK_ESCROW, REVENUE_MERCHANT_COMMISSION.
  code        String            @unique @db.VarChar(120)
  kind        LedgerAccountKind
  ownerType   LedgerOwnerType   @map("owner_type")
  ownerId     String?           @map("owner_id") @db.Uuid
  creditType  CreditType?       @map("credit_type")
  /// Wallets and payables can never go below zero (checked under lock and by a constraint).
  nonNegative Boolean           @map("non_negative")
  currency    String            @default("TND") @db.Char(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  balance AccountBalance?
  entries LedgerEntry[]
  lots    CreditLot[]

  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
}

/// Immutable (trigger). A correction is a new transaction that reverses the original.
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  type           String   @db.VarChar(40)
  /// Tenant and user of the request that created it; with the key, the idempotency safety net.
  tenantId       String?  @map("tenant_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  idempotencyKey String?  @map("idempotency_key") @db.Uuid
  reference      String   @db.VarChar(64)
  reversesId     String?  @map("reverses_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([type, createdAt])
  @@map("ledger_transactions")
}

/// Immutable (trigger). Debits = credits per transaction (deferred constraint trigger).
model LedgerEntry {
  id                   BigInt         @id @default(autoincrement())
  transactionId        String         @map("transaction_id") @db.Uuid
  accountId            String         @map("account_id") @db.Uuid
  direction            EntryDirection
  amountMillimes       BigInt         @map("amount_millimes")
  /// Balance of the account right after this entry (receipts, statements).
  balanceAfterMillimes BigInt         @map("balance_after_millimes")
  lotId                String?        @map("lot_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId, id])
  @@map("ledger_entries")
}

/// Materialized balance, updated in the same SQL transaction as the entries (reconciled daily).
model AccountBalance {
  accountId       String   @id @map("account_id") @db.Uuid
  balanceMillimes BigInt   @map("balance_millimes")
  nonNegative     Boolean  @map("non_negative")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}

/// Expiring lot of credits on an employee wallet, consumed first-expired-first-out (FEFO).
model CreditLot {
  id                  String     @id @default(uuid(7)) @db.Uuid
  accountId           String     @map("account_id") @db.Uuid
  creditType          CreditType @map("credit_type")
  initialMillimes     BigInt     @map("initial_millimes")
  remainingMillimes   BigInt     @map("remaining_millimes")
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(3)
  sourceTransactionId String     @map("source_transaction_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, expiresAt])
  @@map("credit_lots")
}

/// N2 dispute (decision of 2026-10-31): amount held out of the merchant wallet while investigated.
model Dispute {
  id                         String        @id @db.Uuid
  reference                  String        @unique @db.VarChar(32)
  paymentId                  String        @unique @map("payment_id") @db.Uuid
  merchantId                 String        @map("merchant_id") @db.Uuid
  amountMillimes             BigInt        @map("amount_millimes")
  reason                     String        @db.VarChar(500)
  status                     DisputeStatus @default(OPEN)
  openedBy                   String        @map("opened_by") @db.Uuid
  openedByName               String        @map("opened_by_name") @db.VarChar(120)
  openedAt                   DateTime      @default(now()) @map("opened_at") @db.Timestamptz(3)
  dueAt                      DateTime      @map("due_at") @db.Timestamptz(3)
  decisionReason             String?       @map("decision_reason") @db.VarChar(500)
  decidedAt                  DateTime?     @map("decided_at") @db.Timestamptz(3)
  holdTransactionId          String?       @map("hold_transaction_id") @db.Uuid
  /// Payout put on hold by the dispute and its status before (restored when rejected).
  heldPayoutId               String?       @map("held_payout_id") @db.Uuid
  heldPayoutStatus           String?       @map("held_payout_status") @db.VarChar(20)
  paymentPreviousStatus      String        @default("CONFIRMED") @map("payment_previous_status") @db.VarChar(20)
  resolutionTransactionId    String?       @map("resolution_transaction_id") @db.Uuid
  /// Commission cancelled with the refund of a paid payment (decision of 2026-11-02).
  commissionReversedMillimes BigInt        @default(0) @map("commission_reversed_millimes")
  /// VAT of that commission, cancelled with it.
  vatReversedMillimes        BigInt        @default(0) @map("vat_reversed_millimes")

  payment    Payment        @relation(fields: [paymentId], references: [id])
  merchant   Merchant       @relation(fields: [merchantId], references: [id])
  heldPayout PayoutRequest? @relation(fields: [heldPayoutId], references: [id])
  notes      DisputeNote[]

  @@index([status, openedAt], map: "disputes_status_idx")
  @@map("disputes")
}

model DisputeNote {
  id         String   @id @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(120)
  text       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId, createdAt], map: "dispute_notes_dispute_idx")
  @@map("dispute_notes")
}

/// Fraud alert (decision of 2026-10-31): detected by the job, never blocking, handled by Opérations.
model FraudAlert {
  id            String             @id @db.Uuid
  kind          FraudAlertKind
  severity      FraudAlertSeverity
  subject       String             @db.VarChar(120)
  subjectKey    String             @map("subject_key") @db.VarChar(160)
  occurredAt    DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  status        FraudAlertStatus   @default(OPEN)
  handledBy     String?            @map("handled_by") @db.Uuid
  handledByName String?            @map("handled_by_name") @db.VarChar(120)
  closeReason   String?            @map("close_reason") @db.VarChar(500)
  closedAt      DateTime?          @map("closed_at") @db.Timestamptz(3)

  @@unique([kind, subjectKey])
  @@index([status, occurredAt], map: "fraud_alerts_status_idx")
  @@map("fraud_alerts")
}
