{
  "$description": "Source unique des tokens FlexiPay. Génère Tailwind (web) et ThemeData (Flutter). Ne jamais coder de valeur en dur.",
  "color": {
    "navy":        { "value": "#0B1D33", "usage": "Navigation, en-têtes, boutons principaux, texte important" },
    "navy-deep":   { "value": "#12365A", "usage": "États actifs, panneaux" },
    "emerald":     { "value": "#10B981", "usage": "Fonds, icônes, barres de progression (PAS pour du texte sur blanc)" },
    "emerald-text":{ "value": "#047857", "usage": "Texte et montants verts sur fond clair (contraste AA)" },
    "emerald-soft":{ "value": "#D1FAE5", "usage": "Fond des badges positifs" },
    "bg":          { "value": "#F8FAFC", "usage": "Fond général" },
    "surface":     { "value": "#FFFFFF", "usage": "Cartes" },
    "border":      { "value": "#E2E8F0", "usage": "Bordures fines" },
    "text":        { "value": "#0F172A", "usage": "Texte principal" },
    "text-muted":  { "value": "#64748B", "usage": "Texte secondaire" },
    "text-faint":  { "value": "#94A3B8", "usage": "Décoratif uniquement (non conforme AA pour du texte)" },
    "warning":     { "value": "#F59E0B", "usage": "Statut attention (fond, icône)" },
    "warning-text":{ "value": "#B45309", "usage": "Texte de statut attention" },
    "warning-soft":{ "value": "#FEF3C7", "usage": "Fond de badge attention" },
    "danger":      { "value": "#DC2626", "usage": "Erreur, solde insuffisant" },
    "danger-soft": { "value": "#FEE2E2", "usage": "Fond de badge erreur" },
    "info":        { "value": "#2563EB", "usage": "Information" },
    "info-soft":   { "value": "#DBEAFE", "usage": "Fond de badge info" },
    "on-emerald":  { "value": "#0B1D33", "usage": "Texte sur fond emerald" },
    "on-navy":     { "value": "#FFFFFF", "usage": "Texte sur fond navy" }
  },
  "color-dark": {
    "$status": "Optionnel MVP. À valider avant implémentation.",
    "bg": { "value": "#0B1220" },
    "surface": { "value": "#111B2E" },
    "border": { "value": "#1E2A40" },
    "text": { "value": "#F1F5F9" },
    "text-muted": { "value": "#94A3B8" }
  },
  "font": {
    "family": { "value": "Inter, Geist Sans, system-ui, sans-serif" },
    "family-ar": { "value": "IBM Plex Sans Arabic, Noto Sans Arabic, sans-serif" },
    "weight": { "regular": 400, "label": 500, "title": 600, "bold": 700 }
  },
  "type-scale": {
    "micro":    { "size": 12, "line": 16, "weight": 400 },
    "caption":  { "size": 13, "line": 18, "weight": 400 },
    "body":     { "size": 14, "line": 20, "weight": 400 },
    "body-lg":  { "size": 16, "line": 24, "weight": 400 },
    "label":    { "size": 14, "line": 20, "weight": 500 },
    "title-sm": { "size": 18, "line": 24, "weight": 600 },
    "title":    { "size": 22, "line": 28, "weight": 600 },
    "headline": { "size": 28, "line": 34, "weight": 700 },
    "amount":   { "size": 32, "line": 36, "weight": 700 },
    "amount-xl":{ "size": 40, "line": 44, "weight": 700 },
    "currency": { "size": 14, "line": 20, "weight": 500 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": {
    "button": 12,
    "input": 12,
    "card-desktop": 16,
    "card-mobile": 24,
    "card-mobile-lg": 32,
    "badge": 999,
    "avatar": 999
  },
  "size": {
    "input-height": 44,
    "button-height": 44,
    "touch-target-min": 44,
    "desktop-max-width": 1280,
    "sidebar-width": 264
  },
  "shadow": {
    "card": "0 1px 2px rgba(15,23,42,0.06), 0 1px 3px rgba(15,23,42,0.04)",
    "raised": "0 4px 12px rgba(15,23,42,0.08)"
  },
  "motion": { "fast": 120, "base": 200, "slow": 320 },
  "status": {
    "EN_ATTENTE": { "label": "En attente", "bg": "warning-soft", "fg": "warning-text" },
    "VALIDE":     { "label": "Validé",     "bg": "emerald-soft", "fg": "emerald-text" },
    "A_REGLER":   { "label": "À régler",   "bg": "info-soft",    "fg": "info" },
    "REGLE":      { "label": "Réglé",      "bg": "emerald-soft", "fg": "emerald-text" },
    "REFUSE":     { "label": "Refusé",     "bg": "danger-soft",  "fg": "danger" },
    "SUSPENDU":   { "label": "Suspendu",   "bg": "danger-soft",  "fg": "danger" },
    "EN_LITIGE":  { "label": "En litige",  "bg": "danger-soft",  "fg": "danger" },
    "EXPIRE":     { "label": "Expiré",     "bg": "border",       "fg": "text-muted" },
    "SUSPECT":    { "label": "Suspect",    "bg": "warning-soft", "fg": "warning-text" }
  }
}
