{
  "name": "@flexipay/testing-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Testcontainers foundation (PostgreSQL 16, Redis) for FlexiPay integration tests",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "pg": "8.23.0",
    "testcontainers": "11.14.0"
  },
  "devDependencies": {
    "@flexipay/config": "workspace:*",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "ioredis": "5.11.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
